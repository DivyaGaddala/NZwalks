@model List<Nzwalk.UI.Models.DTO.RegionDTO>
@{
}
<style>
    table, th, td {
        border: 1px solid black;
        border-collapse: collapse;
    }

    th, td {
        padding: 8px;
    }
</style>


<h1 class="mt-3">Regions</h1>
<form method="post">
<div class="d-flex justify-content-end">
    <a class="btn btn-secondary"
       asp-controller="Regions"
       asp-action="Add">
        Add Region
    </a>

</div>

<table>
    <thead>
        <tr>
           <th>Id</th>
           <th>Code</th>
           <th>Name</th>
           <th> </th>
          

        </tr>
    </thead>

    <tbody>
        @foreach(var Walks in Model)
        {
            <tr>
                <td>@Walks.Id</td>
               <td>@Walks.Code</td>
                <td>@Walks.Name</td>
               <td>
             
             <a  asp-controller="Regions" asp-action="Edit" asp-route-d="@Walks.Id" asp-route-id ="@Walks.Id" class="btn btn-light">Edit</a>   
              </td>
            </tr>
        }
    </tbody>

</table>
</form>

